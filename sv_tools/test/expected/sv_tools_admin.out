-- sv_tools regression: admin helpers and edge cases
set client_min_messages = warning;
drop extension if exists sv_tools cascade;
drop schema if exists sv cascade;
reset client_min_messages;
create schema sv;
create extension sv_tools schema sv;
set search_path = sv, public;
-- 1. empty list before anything is set
select count(*) from sv_list();
 count 
-------
     0
(1 row)

-- 2. getters return null for missing variables
select sv_getint('nope');
ERROR:  function sv_getint(unknown) is not unique
LINE 1: select sv_getint('nope');
               ^
HINT:  Could not choose a best candidate function. You might need to add explicit type casts.
select sv_gettext('nope');
ERROR:  function sv_gettext(unknown) is not unique
LINE 1: select sv_gettext('nope');
               ^
HINT:  Could not choose a best candidate function. You might need to add explicit type casts.
select sv_getbool('nope');
ERROR:  function sv_getbool(unknown) is not unique
LINE 1: select sv_getbool('nope');
               ^
HINT:  Could not choose a best candidate function. You might need to add explicit type casts.
select count(*) from sv_get('nope', null::int);
ERROR:  relation "sv_session_vars" does not exist
LINE 1: select var_value_int from sv_session_vars where var_name = $...
                                  ^
QUERY:  select var_value_int from sv_session_vars where var_name = $1 and var_type = $2::sv_regtype
CONTEXT:  PL/pgSQL function sv_get(text,anyelement,boolean) line 18 at RETURN QUERY
-- 3. unset on a missing variable
select sv_unset('nope');
 sv_unset 
----------
 f
(1 row)

-- 4. populate a few and inspect
select sv_set('a', 1);
 sv_set 
--------
      1
(1 row)

select sv_set('b', 'two');
 sv_set 
--------
 two
(1 row)

select sv_set('c', true);
 sv_set 
--------
 t
(1 row)

select var_name, var_type, var_value from sv_list()
where var_name in ('a','b','c')
order by var_name;
 var_name | var_type | var_value 
----------+----------+-----------
 a        | integer  | 1
 b        | text     | "two"
 c        | boolean  | true
(3 rows)

-- 5. unset one by one
select sv_unset('a');
 sv_unset 
----------
 t
(1 row)

select count(*) from sv_list() where var_name in ('a','b','c');
 count 
-------
     2
(1 row)

select sv_unset('b');
 sv_unset 
----------
 t
(1 row)

select sv_unset('c');
 sv_unset 
----------
 t
(1 row)

select count(*) from sv_list();
 count 
-------
     0
(1 row)


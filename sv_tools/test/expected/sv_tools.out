create schema if not exists sv;
create extension if not exists sv_tools schema sv;
set search_path = sv, public;
-- Basic
select sv_set('x', 42);
 sv_set 
--------
     42
(1 row)

select sv_getint('x');
 sv_getint 
-----------
        42
(1 row)

-- Change type
select sv_set('x', 'hello');
 sv_set 
--------
 hello
(1 row)

select sv_gettext('x');
 sv_gettext 
------------
 hello
(1 row)

-- typed NULL
select sv_set('y', NULL::int);

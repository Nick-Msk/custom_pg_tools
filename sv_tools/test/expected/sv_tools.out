-- sv_tools regression: basic single-variable behaviour
set client_min_messages = warning;
drop extension if exists sv_tools cascade;
drop schema if exists sv cascade;
reset client_min_messages;
create schema sv;
create extension sv_tools schema sv;
set search_path = sv, public;
-- 1. set/get int
select sv_set('x', 42);
 sv_set 
--------
     42
(1 row)

select sv_getint('x');
 sv_getint 
-----------
        42
(1 row)

-- 2. overwrite with another type (no check)
select sv_set('x', 'hello');
 sv_set 
--------
 hello
(1 row)

select sv_gettext('x');
 sv_gettext 
------------
 hello
(1 row)

-- 3. null value keeps its type
select sv_set('y', null::int);
 sv_set 
--------
       
(1 row)

select sv_getint('y');
 sv_getint 
-----------
          
(1 row)

-- 4. wrong type read yields null
select sv_gettext('y');
 sv_gettext 
------------
 
(1 row)

-- 5. check_type => true forbids reassignment
select sv_set('z', 1, true);
 sv_set 
--------
      1
(1 row)

select sv_set('z', 'oops', true);   -- error expected
ERROR:  session variable "z" is already integer, cannot reassign as text
CONTEXT:  PL/pgSQL function sv__set(text,sv_regtype,integer,bigint,double precision,numeric,text,boolean,jsonb,boolean) line 13 at RAISE
SQL statement "SELECT sv__set(p_name, 'text'::sv_regtype,
                    p_value_text := p_value, p_check_type := p_check_type)"
PL/pgSQL function sv_set(text,text,boolean) line 3 at PERFORM
-- 6. unset return values
select sv_unset('z');   -- true
 sv_unset 
----------
 t
(1 row)

select sv_unset('z');   -- false, already gone
 sv_unset 
----------
 f
(1 row)

-- getters with p_check_type
select sv_set('x', 42);
 sv_set 
--------
     42
(1 row)

select sv_getint('x');              -- 42
 sv_getint 
-----------
        42
(1 row)

select sv_getint('x', true);        -- 42
 sv_getint 
-----------
        42
(1 row)

select sv_gettext('x');             -- null, silent
 sv_gettext 
------------
 
(1 row)

select sv_gettext('x', true);       -- error
ERROR:  session variable "x" does not exist or is not text
CONTEXT:  PL/pgSQL function sv_gettext(text,boolean) line 8 at RAISE
select sv_getint('missing');        -- null, silent
 sv_getint 
-----------
          
(1 row)

select sv_getint('missing', true);  -- error
ERROR:  session variable "missing" does not exist or is not int4
CONTEXT:  PL/pgSQL function sv_getint(text,boolean) line 8 at RAISE
-- null value is fine
select sv_set('y', null::int);
 sv_set 
--------
       
(1 row)

select sv_getint('y', true);        -- null, no error
 sv_getint 
-----------
          
(1 row)

